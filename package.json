{
	"name": "openai_api_local",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx src/index.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/index.js",
		"typecheck": "tsc --noEmit",
		"example:chat_openai": "tsx examples/openai_chat_openai.ts",
		"example:chat_lmstudio": "tsx examples/openai_chat_lmstudio.ts",
		"example:chat_ollama": "tsx examples/openai_chat_ollama.ts",
		"example:chat_gemini": "tsx examples/openai_chat_gemini.ts",
		"example:chat_all": "npm run example:chat_openai && npm run example:chat_lmstudio && npm run example:chat_ollama && npm run example:chat_gemini",
		"example:agent_openai": "tsx examples/agent_sdk_openai.ts",
		"example:agent_lmstudio": "tsx examples/agent_sdk_lmstudio.ts",
		"example:agent_ollama": "tsx examples/agent_sdk_ollama.ts",
		"example:agent_gemini": "tsx examples/agent_sdk_gemini.ts",
		"example:agent_all": "npm run example:agent_openai && npm run example:agent_lmstudio && npm run example:agent_ollama && npm run example:agent_gemini",
		"example:chat_openai_full": "tsx examples/openai_chat_openai_full.ts"
	},
	"devDependencies": {
		"@types/node": "^22.10.0",
		"tsx": "^4.19.0",
		"typescript": "^5.7.0"
	},
	"dependencies": {
		"@keyv/sqlite": "^4.0.8",
		"@openai/agents": "^0.11.5",
		"cacheable": "^2.3.5",
		"openai": "^6.39.0",
		"openai-cache": "^1.0.35",
		"openai-cost": "^1.0.27",
		"zod": "^4.4.3"
	}
}
